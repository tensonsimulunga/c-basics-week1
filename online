

#include <stdio.h>
#include <string.h>
#include <time.h>

#define MAX_TRANSACTIONS 100


struct Account {
    char name[100];
    int accountNumber;
    char password[50];
    float balance;

    char transactions[MAX_TRANSACTIONS][200];
    int transactionCount;
};


void createAccount(struct Account accounts[], int *count);
int login(struct Account accounts[], int count);
void deposit(struct Account accounts[], int index);
void withdraw(struct Account accounts[], int index);
void transfer(struct Account accounts[], int count, int index);
void changePassword(struct Account accounts[], int index);
void displayDetails(struct Account accounts[], int index);
void viewTransactions(struct Account accounts[], int index);
int findAccountOnly(struct Account accounts[], int count, int accNo);
void getCurrentDateTime(char *buffer, int size);


int main() {
    struct Account accounts[100];
    int count = 0;
    int choice;

    
    printf("==========================================\n");
    printf("Online Banking System - C Programming\n");
    printf("Author: Tenson Simulunga\n");
    printf("Student Number: 2025015922\n");
    printf("==========================================\n");

    do {
        printf("\n========== Main Menu ==========\n");
        printf("1. Create Account\n");
        printf("2. Login\n");
        printf("3. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch(choice) {
            case 1:
                createAccount(accounts, &count);
                break;

            case 2: {
                int loggedIndex = login(accounts, count);
                if(loggedIndex != -1) {
                    int op;
                    do {
                        printf("\n===== Welcome, %s =====\n", accounts[loggedIndex].name);
                        printf("1. Deposit Funds\n");
                        printf("2. Withdraw Funds\n");
                        printf("3. Transfer Funds\n");
                        printf("4. Change Password\n");
                        printf("5. View Account Details\n");
                        printf("6. View Transaction History\n");
                        printf("7. Logout\n");
                        printf("Choose option: ");
                        scanf("%d", &op);

                        switch(op) {
                            case 1: deposit(accounts, loggedIndex); break;
                            case 2: withdraw(accounts, loggedIndex); break;
                            case 3: transfer(accounts, count, loggedIndex); break;
                            case 4: changePassword(accounts, loggedIndex); break;
                            case 5: displayDetails(accounts, loggedIndex); break;
